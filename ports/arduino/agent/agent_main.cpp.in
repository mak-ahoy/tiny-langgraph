/*
 * @NAME@ on a @BOARD@, generated by tiny-langgraph from @SOURCE@.
 * The web page shows the agent thinking; risky tools wait for your approval.
 *
 *   1. Edit config.h (Wi-Fi, PIN, time zone).
 *   2. Tools menu:@BOARD_SETUP@
 *   3. Upload, open the Serial Monitor at 115200, and open the address it prints.
 *
 * Web API (same origin only, no CORS on purpose):
 *   GET  /                 the trace viewer
 *   GET  /tlg/info         {"board":..., "boot":...}
 *   GET  /tlg/events       ?since=N[&graph=1] -> trace lines; headers X-Last, X-More, X-Boot
 *   GET  /tlg/pending      {"pending":true,"run":7,"question":"approve alarm?"}
 *   POST /tlg/answer       pin, run, answer=yes|no
 *   GET  /snapshot.jpg     the last camera snapshot (if the agent has a camera)
 *   GET  /tlg/log          {"days":[{"day":"2026-11-09","bytes":170000},...],"keep":30,"bytes":...}
 *   GET  /tlg/log.csv      the data log, every day in one CSV (?day=2026-11-09 for one day)
 *   POST /tlg/log/clear    pin: deletes the data log
 *
 * Data log: once the clock is synced, every run appends one line to /log/<day>.csv on the
 * flash (time, epoch, hour, every Choice/Score field, the plan). The last LOG_DAYS days are
 * kept. Download it from the web page, then fit models on your PC (tiny_langgraph.datalog).
 */
#include <Arduino.h>
#include <time.h>

#include <algorithm>
#include <vector>

#undef BOOT_PIN                          /* some cores define it; config.h says which pin */
#include "config.h"                    /* your settings: Wi-Fi, PIN, time zone, ... */

/* ======================= platform: the only part that differs between boards =======================
 * ESP32:   the agent runs in its own FreeRTOS task; loop() serves the web page meanwhile, so the
 *          two share data under locks. The data log is on FFat.
 * ESP8266: one loop, no tasks: loop() serves the web page and runs the agent, and waiting for an
 *          approval keeps serving (pump). Locks aren't needed. The data log is on LittleFS.     */
#if defined(ESP8266)
#include <ESP8266WebServer.h>
#include <ESP8266WiFi.h>
#include <ESP8266mDNS.h>
#include <LittleFS.h>
typedef ESP8266WebServer web_server_t;
#define LOG_FS       LittleFS
#define HUB_SLOTS    24                    /* trace events kept for the web page (RAM is short) */
#define EVENTS_BUF   (4 * 1024)
typedef int lock_t;
static lock_t lock_new(void) { return 0; }
static bool   lock_take(lock_t l, uint32_t ms) { (void)l; (void)ms; return true; }
static void   lock_give(lock_t l) { (void)l; }
#define CRIT_ENTER() do {} while (0)
#define CRIT_EXIT()  do {} while (0)
static uint32_t board_random(void) { return ESP.random(); }
static void    *big_alloc(size_t n) { return malloc(n); }
static bool     big_memory(void) { return false; }
static bool     fs_begin(void) { return LittleFS.begin(); }      /* formats a blank file system */
static size_t   fs_free(void) { FSInfo i; return LittleFS.info(i) ? i.totalBytes - i.usedBytes : 0; }
static void     set_hostname(const char *h) { WiFi.hostname(h); }
static void     time_sync(void) { configTime(TIMEZONE, "pool.ntp.org", "time.google.com"); }
static void     pump(void);                /* serve the web page and serial while the agent waits */
static void     board_wait(uint32_t ms) { pump(); delay(ms); }
#ifndef FILE_APPEND
#define FILE_APPEND "a"
#endif
#elif defined(ESP32)
#include <ESPmDNS.h>
#include <FFat.h>
#include <WebServer.h>
#include <WiFi.h>
typedef WebServer web_server_t;
#define LOG_FS       FFat
#define HUB_SLOTS    (psramFound() ? 256 : 48)
#define EVENTS_BUF   (12 * 1024)
typedef SemaphoreHandle_t lock_t;
static lock_t lock_new(void) { return xSemaphoreCreateMutex(); }
static bool   lock_take(lock_t l, uint32_t ms)
{
    return xSemaphoreTake(l, ms == UINT32_MAX ? portMAX_DELAY : pdMS_TO_TICKS(ms)) == pdTRUE;
}
static void   lock_give(lock_t l) { xSemaphoreGive(l); }
static portMUX_TYPE mux = portMUX_INITIALIZER_UNLOCKED;
#define CRIT_ENTER() portENTER_CRITICAL(&mux)
#define CRIT_EXIT()  portEXIT_CRITICAL(&mux)
static uint32_t board_random(void) { return esp_random(); }
static void    *big_alloc(size_t n) { return psramFound() ? ps_malloc(n) : malloc(n); }
static bool     big_memory(void) { return psramFound(); }
static bool     fs_begin(void) { return FFat.begin(true); }      /* true: format a blank partition */
static size_t   fs_free(void) { return FFat.totalBytes() - FFat.usedBytes(); }
static void     set_hostname(const char *h) { WiFi.setHostname(h); }
static void     time_sync(void) { configTzTime(TIMEZONE, "pool.ntp.org", "time.google.com"); }
static void     board_wait(uint32_t ms) { vTaskDelay(pdMS_TO_TICKS(ms)); }
#else
#error "tiny-langgraph's sketch runs on ESP32 and ESP8266 boards (see python/tiny_langgraph/boards.py)"
#endif
#define FOREVER UINT32_MAX
/* =================================================================================================== */

#ifndef SERIAL_LOG             /* config.h files from before these settings existed */
#define SERIAL_LOG 1
#endif
#ifndef LOG_DAYS
#define LOG_DAYS @LOG_DAYS@
#endif
#include "tlg_build.h"
#include "web_viewer.h"
#if TLG_HAS_MODEL
#include "@p@_model.h"
#endif

extern "C" {
#include "@p@_agent.h"
#include "tlg_drivers.h"
#include "tlg_hub.h"
#if TLG_USES_MODEL
#include "tlg_lm.h"
#endif
}

static web_server_t      server(80);
static tlg_hub_t         hub;
static lock_t           hub_lock;
static tlg_tracer_t      tracer;
#if TLG_HAS_MODEL
static tlg_lm_t          lm;
#endif
static @p@_state_t       state;
static volatile bool     run_requested;
static uint32_t          boot_id;

static uint32_t          pending_run;       /* 0 = nothing waiting */
static char              pending_question[48];
static int               answer_given;      /* 0 none, 1 yes, 2 no */
static const char       *answer_from = "";
static int               pin_failures;
static uint32_t          pin_locked_until;

static lock_t           log_lock;          /* the agent writes the log, the web page reads it */
static bool              log_ok;            /* the flash file system is mounted */
static char              log_pending[2048]; /* lines waiting while the web page reads the log */
static size_t            log_pending_len;
static uint32_t          log_dropped;       /* lines that didn't fit while waiting */
static char              log_today[11];     /* "2026-11-09": old days are deleted once a day */

/* ---------------- tracing ---------------- */
static uint32_t clock_ms(void) { return millis(); }
static uint32_t clock_us(void) { return micros(); }

static void trace_write(const char *line, void *ctx)
{
    (void)ctx;
    lock_take(hub_lock, FOREVER);
    tlg_hub_put(&hub, line);
    lock_give(hub_lock);
    if (SERIAL_LOG && SERIAL_TRACE) Serial.print(line);
}

static void human_log(const char *line, void *ctx)
{
    (void)ctx;
    if (SERIAL_LOG && !SERIAL_TRACE) Serial.printf("    %s\n", line);
}

/* Phone().send(...) from your agent: a note in the trace (the web page shows it) */
extern "C" void tlg_phone_send(const char *text)
{
    tlg_trace_note(&tracer, "message: %s", text);
    if (SERIAL_LOG && !SERIAL_TRACE) Serial.printf("  >>> message: %s\n", text);
}

/* ---------------- approvals ---------------- */
static tlg_answer_t wait_for_answer(uint32_t run_id, const char *question)
{
    CRIT_ENTER();
    pending_run = run_id;
    strncpy(pending_question, question, sizeof pending_question - 1);
    pending_question[sizeof pending_question - 1] = '\0';
    answer_given = 0;
    CRIT_EXIT();

    Serial.printf("\n  >>> %s  (web page with PIN, BOOT button = yes, or type y/n here)\n", question);
    tlg_answer_t a = TLG_ANSWER_NO;
    const char *from = "timeout";
    uint32_t t0 = millis();
    while (millis() - t0 < APPROVAL_TIMEOUT_MS) {
        int given;
        CRIT_ENTER();
        given = answer_given;
        CRIT_EXIT();
        if (given) { a = given == 1 ? TLG_ANSWER_YES : TLG_ANSWER_NO; from = answer_from; break; }
        if (digitalRead(BOOT_PIN) == LOW) { a = TLG_ANSWER_YES; from = "BOOT button"; break; }
        board_wait(50);
    }
    CRIT_ENTER();
    pending_run = 0;
    CRIT_EXIT();
    tlg_trace_note(&tracer, "answer: %s (from %s)", a == TLG_ANSWER_YES ? "yes" : "no", from);
    if (!SERIAL_TRACE) Serial.printf("  >>> answer: %s (from %s)\n", a == TLG_ANSWER_YES ? "yes" : "no", from);
    return a;
}

static bool give_answer(uint32_t run, bool yes, const char *from)
{
    bool ok = false;
    CRIT_ENTER();
    if (pending_run != 0 && (run == 0 || run == pending_run) && answer_given == 0) {
        answer_given = yes ? 1 : 2;
        answer_from = from;
        ok = true;
    }
    CRIT_EXIT();
    return ok;
}

/* ---------------- data log: a CSV file per day on the flash, the last LOG_DAYS days ---------------- */
static bool clock_synced(void) { return time(nullptr) > 1700000000; }   /* after Nov 2023: NTP has answered */

/* The day files, oldest first ("2026-11-08.csv", ...). Call with log_lock held. */
static std::vector<String> log_files(void)
{
    std::vector<String> names;
    File dir = LOG_FS.open("/log", "r");
    if (!dir || !dir.isDirectory()) return names;
    for (File f = dir.openNextFile(); f; f = dir.openNextFile()) {
        String name = f.name();
        int slash = name.lastIndexOf('/');
        if (slash >= 0) name = name.substring(slash + 1);
        if (name.endsWith(".csv")) names.push_back(name);
    }
    std::sort(names.begin(), names.end());               /* the names sort by date */
    return names;
}

/* After each run: one line, written now or (if the web page is reading the log) next run. */
static void log_run(void)
{
    if (!log_ok || !clock_synced()) return;               /* no real time yet: a line would be misdated */
    time_t now = time(nullptr);
    struct tm lt;
    localtime_r(&now, &lt);
    char day[11], row[400], line[480];
    strftime(day, sizeof day, "%Y-%m-%d", &lt);
    @p@_log_row(&state, row, sizeof row);
    int n = snprintf(line, sizeof line, "%sT%02d:%02d:%02d,%lu,%d,%s\n", day, lt.tm_hour, lt.tm_min, lt.tm_sec,
                     (unsigned long)now, lt.tm_hour, row);
    if (n > 0 && (size_t)n < sizeof line && log_pending_len + (size_t)n < sizeof log_pending) {
        memcpy(log_pending + log_pending_len, line, (size_t)n);
        log_pending_len += (size_t)n;
    } else {
        log_dropped++;
    }
    if (!lock_take(log_lock, 50)) return;
    char path[24];
    snprintf(path, sizeof path, "/log/%s.csv", day);
    bool fresh = !LOG_FS.exists(path);
    File f = LOG_FS.open(path, FILE_APPEND);
    if (f) {
        if (fresh) {                                      /* each file starts with the column names */
            char head[400];
            @p@_log_header(head, sizeof head);
            f.printf("time,epoch,hour,%s\n", head);
        }
        f.write((const uint8_t *)log_pending, log_pending_len);
        f.close();                                        /* closed every run: a power cut loses one line at most */
        log_pending_len = 0;
    }
    if (strcmp(day, log_today) != 0) {                    /* a new day: delete days beyond LOG_DAYS */
        strcpy(log_today, day);
        std::vector<String> names = log_files();
        for (size_t i = 0; i + LOG_DAYS < names.size(); i++) LOG_FS.remove("/log/" + names[i]);
    }
    lock_give(log_lock);
}

static void log_begin(void)
{
    log_lock = lock_new();
    if (LOG_DAYS <= 0) { Serial.println("data log: off (LOG_DAYS 0)"); return; }
    log_ok = fs_begin() && (LOG_FS.exists("/log") || LOG_FS.mkdir("/log"));
    if (!log_ok) {
        Serial.println("data log: OFF, no file system partition (see the Tools menu steps at the top of this file)");
        return;
    }
    size_t days = log_files().size();
    Serial.printf("data log: %u days stored, keeps %d, %lu KB free\n", (unsigned)days, LOG_DAYS,
                  (unsigned long)(fs_free() / 1024));
}

/* ---------------- the network: ESP-NOW broadcast to other boards (tiny_langgraph.net) ----------------
 * Every message goes to everyone in range on this Wi-Fi channel; tlg_net keeps only those for this
 * board, from boards with the same NET_KEY. Not encrypted yet: anyone in range who knows the key can
 * send requests, but this board's own rules still decide what it does. */
#if TLG_USE_NET
#if defined(ESP8266)
#include <espnow.h>
#else
#include <esp_arduino_version.h>
#include <esp_now.h>
#endif
#ifndef NET_KEY                          /* config.h files from before this setting existed */
#define NET_KEY "tiny-langgraph"
#endif
#define RX_SLOTS 8

static uint8_t           BCAST[6] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF };
static uint8_t           rx_buf[RX_SLOTS][TLG_NET_MSG];   /* messages the radio received, for loop() */
static uint8_t           rx_len[RX_SLOTS];
static volatile uint8_t  rx_head, rx_count;
static lock_t            net_lock_h;
static bool              net_ok;

static void net_lock(void) { lock_take(net_lock_h, FOREVER); }
static void net_unlock(void) { lock_give(net_lock_h); }

static void rx_push(const uint8_t *data, int len)          /* from the radio: just keep it */
{
    if (len <= 0 || len > TLG_NET_MSG) return;
    CRIT_ENTER();
    if (rx_count < RX_SLOTS) {
        uint8_t slot = (uint8_t)((rx_head + rx_count) % RX_SLOTS);
        memcpy(rx_buf[slot], data, (size_t)len);
        rx_len[slot] = (uint8_t)len;
        rx_count = rx_count + 1;
    }
    CRIT_EXIT();
}

#if defined(ESP8266)
static void on_recv(uint8_t *mac, uint8_t *data, uint8_t len) { (void)mac; rx_push(data, len); }
#elif ESP_ARDUINO_VERSION_MAJOR >= 3
static void on_recv(const esp_now_recv_info_t *info, const uint8_t *data, int len) { (void)info; rx_push(data, len); }
#else
static void on_recv(const uint8_t *mac, const uint8_t *data, int len) { (void)mac; rx_push(data, len); }
#endif

static void net_send(const uint8_t *buf, int len)
{
#if defined(ESP8266)
    esp_now_send(BCAST, (uint8_t *)buf, (uint8_t)len);
#else
    esp_now_send(BCAST, buf, (size_t)len);
#endif
}

static void net_begin(void)                                 /* after Wi-Fi is up: ESP-NOW shares its channel */
{
    tlg_net_t *n = @p@_net();
    n->net_id = tlg_net_id(NET_KEY);
    net_lock_h = lock_new();
    /* Keep the radio awake: with Wi-Fi power saving (the default when joined to a router) the radio
       sleeps between the router's beacons and misses most broadcasts from other boards. */
#if defined(ESP8266)
    WiFi.setSleepMode(WIFI_NONE_SLEEP);
#else
    WiFi.setSleep(false);
#endif
    n->lock = net_lock;
    n->unlock = net_unlock;
#if defined(ESP8266)
    net_ok = esp_now_init() == 0;
    if (net_ok) {
        esp_now_set_self_role(ESP_NOW_ROLE_COMBO);
        esp_now_add_peer(BCAST, ESP_NOW_ROLE_COMBO, (uint8_t)WiFi.channel(), NULL, 0);
        esp_now_register_recv_cb(on_recv);
    }
#else
    net_ok = esp_now_init() == ESP_OK;
    if (net_ok) {
        esp_now_peer_info_t p = {};
        memcpy(p.peer_addr, BCAST, 6);
        p.channel = 0;                                      /* the current Wi-Fi channel */
        p.encrypt = false;
        esp_now_add_peer(&p);
        esp_now_register_recv_cb(on_recv);
    }
#endif
    Serial.printf("network: %s as \"@p@\" on Wi-Fi channel %d (boards must share the channel and NET_KEY)\n",
                  net_ok ? "ESP-NOW" : "ESP-NOW NOT started", (int)WiFi.channel());
}

/* From loop(): received messages into the mailbox, our announcement every few seconds, and
 * every message the agent queued (calls, replies) out. */
static void net_service(void)
{
    if (!net_ok) return;
    static uint32_t last_announce;
    static bool announced;
    tlg_net_t *n = @p@_net();
    uint32_t now = millis();
    uint8_t buf[TLG_NET_MSG];
    for (;;) {
        int len = 0;
        CRIT_ENTER();
        if (rx_count) {
            len = rx_len[rx_head];
            memcpy(buf, rx_buf[rx_head], (size_t)len);
            rx_head = (uint8_t)((rx_head + 1) % RX_SLOTS);
            rx_count = rx_count - 1;
        }
        CRIT_EXIT();
        if (!len) break;
        tlg_net_receive(n, buf, (size_t)len, now);
    }
    net_lock();
    tlg_net_tick(n, now);
    net_unlock();
    if (!announced || now - last_announce >= TLG_NET_ANNOUNCE_MS) {
        int len = tlg_net_announce(n, buf, sizeof buf);
        if (len > 0) net_send(buf, len);
        last_announce = now;
        announced = true;
    }
    int len;
    while ((len = tlg_net_next_out(n, buf, sizeof buf)) > 0) net_send(buf, len);
}
#else
static void net_begin(void) {}
static void net_service(void) {}
#endif

/* ---------------- the agent task ---------------- */
static void run_once(tlg_graph_t *g, uint32_t n)
{
    char label[32];
    snprintf(label, sizeof label, "run %lu", (unsigned long)n);
    @p@_begin(&state);
    tlg_trace_run(&tracer, label);
    if (SERIAL_LOG && !SERIAL_TRACE) Serial.printf("\n[%s]\n", label);

    tlg_run_t run;
    tlg_run_init(&run, g);
    uint32_t t0 = micros();
    tlg_status_t st = tlg_invoke(g, &run, &state);
    while (st == TLG_INTERRUPTED) {
        tlg_trace_end(&tracer, &run);
        state.agent.answer = wait_for_answer(tracer.run_id, run.interrupt_reason);
        st = tlg_invoke(g, &run, &state);
    }
    tlg_trace_end(&tracer, &run);
    uint32_t run_us = micros() - t0;          /* stop the clock before printing anything */
    if (!SERIAL_LOG || !SERIAL_TRACE) {       /* with SERIAL_LOG 0, this is the only line per run */
        char model[24] = "";
#if TLG_USES_MODEL
        snprintf(model, sizeof model, "model %lu ms, ", (unsigned long)state.agent.lm_ms);
#endif
        Serial.printf("  -> %s after %lu steps (%splanner %lu us, verify %lu us, run %lu.%02lu ms, free heap %lu)\n",
                      tlg_status_str(st), (unsigned long)run.step, model, (unsigned long)state.agent.plan_us,
                      (unsigned long)state.agent.verify_us, (unsigned long)(run_us / 1000),
                      (unsigned long)(run_us % 1000 / 10), (unsigned long)ESP.getFreeHeap());
    }
    log_run();                                /* after the timing: writing to flash isn't part of the run */
}

static tlg_graph_t agent_graph;
static bool        agent_ok;
static uint32_t    agent_runs, agent_last;
static volatile uint32_t agent_done;           /* runs finished (MCP calls wait for the next one) */
static volatile bool     agent_running;

static void agent_start(void)
{
    @p@_graph(&agent_graph, &state);
    char err[96];
    if (tlg_validate(&agent_graph, err, sizeof err) < 0) {
        Serial.printf("invalid graph: %s\n", err);
        return;
    }
    tlg_trace_graph(&tracer, &agent_graph, "@NAME@");
    agent_ok = true;
    agent_last = millis();
    run_requested = true;                       /* once at boot */
}

/* Runs the graph when it's due (every RUN_EVERY_MS) or asked for (r in the Serial Monitor). */
static void agent_poll(void)
{
    if (!agent_ok) return;
    bool due = RUN_EVERY_MS > 0 && millis() - agent_last >= RUN_EVERY_MS;
    if (!run_requested && !due) return;
    run_requested = false;
    agent_running = true;
    run_once(&agent_graph, ++agent_runs);
    agent_last = millis();
    agent_running = false;
    agent_done = agent_done + 1;
}

#if defined(ESP32)
static void agent_task(void *arg)              /* its own task: loop() keeps serving the web page */
{
    (void)arg;
    agent_start();
    for (;;) {
        agent_poll();
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}
#endif

/* ---------------- web server ---------------- */
static void no_cache() { server.sendHeader("Cache-Control", "no-store"); }

static void handle_root()
{
    server.sendHeader("Content-Encoding", "gzip");
    server.send_P(200, "text/html", (PGM_P)WEB_VIEWER_GZ, WEB_VIEWER_GZ_LEN);
}

static void handle_info()
{
    char body[192];
    snprintf(body, sizeof body,
             "{\"board\":\"@NAME@\",\"boot\":\"%08lx\",\"approval\":true,\"camera\":%s,\"log\":%s,\"synced\":%s}",
             (unsigned long)boot_id, TLG_USE_CAMERA ? "true" : "false", log_ok ? "true" : "false",
             clock_synced() ? "true" : "false");
    no_cache();
    server.send(200, "application/json", body);
}

static void handle_events()
{
    static char out[EVENTS_BUF];
    uint32_t since = (uint32_t)strtoul(server.arg("since").c_str(), NULL, 10);
    int with_graph = server.hasArg("graph");
    uint32_t last;
    int more;
    lock_take(hub_lock, FOREVER);
    size_t n = tlg_hub_get(&hub, since, with_graph, out, sizeof out, &last, &more);
    lock_give(hub_lock);
    char buf[16];
    snprintf(buf, sizeof buf, "%lu", (unsigned long)last);
    server.sendHeader("X-Last", buf);
    server.sendHeader("X-More", more ? "1" : "0");
    snprintf(buf, sizeof buf, "%08lx", (unsigned long)boot_id);
    server.sendHeader("X-Boot", buf);
    no_cache();
    server.send_P(200, "text/plain", out, n);
}

static void handle_pending()
{
    char q[48], esc[96], body[160];
    uint32_t run;
    CRIT_ENTER();
    run = pending_run;
    memcpy(q, pending_question, sizeof q);
    CRIT_EXIT();
    if (run) {
        tlg_json_escape(q, esc, sizeof esc);
        snprintf(body, sizeof body, "{\"pending\":true,\"run\":%lu,\"question\":\"%s\"}", (unsigned long)run, esc);
    } else {
        snprintf(body, sizeof body, "{\"pending\":false}");
    }
    no_cache();
    server.send(200, "application/json", body);
}

/* The PIN in the request is right; otherwise answers the request (wrong PIN, or locked after 5 tries). */
static bool pin_ok()
{
    char body[96];
    if (millis() < pin_locked_until) {
        snprintf(body, sizeof body, "{\"error\":\"locked\",\"retry\":%lu}",
                 (unsigned long)((pin_locked_until - millis()) / 1000 + 1));
        server.send(429, "application/json", body);
        return false;
    }
    if (server.arg("pin") != APPROVAL_PIN) {
        if (++pin_failures >= 5) { pin_locked_until = millis() + 60000; pin_failures = 0; }
        server.send(403, "application/json", "{\"error\":\"wrong pin\"}");
        return false;
    }
    pin_failures = 0;
    return true;
}

static void handle_answer()
{
    if (!pin_ok()) return;
    String ans = server.arg("answer");
    if (ans != "yes" && ans != "no") {
        server.send(400, "application/json", "{\"error\":\"answer must be yes or no\"}");
        return;
    }
    uint32_t run = (uint32_t)strtoul(server.arg("run").c_str(), NULL, 10);
    if (!give_answer(run, ans == "yes", "web page")) {
        server.send(409, "application/json", "{\"error\":\"nothing is waiting for an answer\"}");
        return;
    }
    server.send(200, "application/json", "{\"ok\":true}");
}

static void handle_snapshot()
{
    const uint8_t *jpeg;
    size_t len;
    if (!tlg_camera_last(&jpeg, &len)) { server.send(404, "text/plain", "no snapshot yet"); return; }
    no_cache();
    server.send_P(200, "image/jpeg", (const char *)jpeg, len);
}

static void handle_log_list()
{
    String body = "{\"days\":[";
    size_t total = 0;
    if (log_ok) {
        lock_take(log_lock, FOREVER);
        std::vector<String> names = log_files();
        for (size_t i = 0; i < names.size(); i++) {
            File f = LOG_FS.open("/log/" + names[i], "r");
            size_t bytes = f ? f.size() : 0;
            if (f) f.close();
            total += bytes;
            body += (i ? ",{\"day\":\"" : "{\"day\":\"") + names[i].substring(0, names[i].length() - 4)
                    + "\",\"bytes\":" + String((unsigned long)bytes) + "}";
        }
        lock_give(log_lock);
    }
    body += "],\"keep\":" + String(LOG_DAYS) + ",\"bytes\":" + String((unsigned long)total)
            + ",\"on\":" + (log_ok ? "true" : "false") + ",\"synced\":" + (clock_synced() ? "true" : "false")
            + ",\"dropped\":" + String((unsigned long)log_dropped) + "}";
    no_cache();
    server.send(200, "application/json", body);
}

/* Every day (or ?day=YYYY-MM-DD) as one CSV, the column names once. Streamed a day at a time:
   while a day is being sent the agent keeps its log lines in RAM and writes them next run. */
static void handle_log_csv()
{
    if (!log_ok) { server.send(404, "text/plain", "the data log is off"); return; }
    String only = server.arg("day");
    lock_take(log_lock, FOREVER);
    std::vector<String> names = log_files();
    lock_give(log_lock);
    server.setContentLength(CONTENT_LENGTH_UNKNOWN);
    server.sendHeader("Content-Disposition", "attachment; filename=\"@NAME@-log" + (only.length() ? "-" + only : String("")) + ".csv\"");
    no_cache();
    server.send(200, "text/csv", "");
    static char buf[1024];
    bool first = true;
    for (const String &name : names) {
        if (only.length() && name != only + ".csv") continue;
        lock_take(log_lock, FOREVER);
        File f = LOG_FS.open("/log/" + name, "r");
        if (f) {
            if (!first) f.readStringUntil('\n');          /* the column names: once is enough */
            int n;
            while ((n = f.read((uint8_t *)buf, sizeof buf)) > 0) server.sendContent(buf, (size_t)n);
            f.close();
            first = false;
        }
        lock_give(log_lock);
    }
    server.sendContent("");                               /* end of the chunked reply */
}

static void handle_log_clear()
{
    if (!pin_ok()) return;
    int removed = 0;
    if (log_ok) {
        lock_take(log_lock, FOREVER);
        for (const String &name : log_files()) removed += LOG_FS.remove("/log/" + name) ? 1 : 0;
        log_today[0] = '\0';
        lock_give(log_lock);
    }
    Serial.printf("data log: cleared (%d days) from the web page\n", removed);
    server.send(200, "application/json", "{\"ok\":true,\"removed\":" + String(removed) + "}");
}

/* ---------------- MCP: AI clients call this board's tools (core/tlg_mcp.c) ----------------
 * POST /mcp with JSON-RPC (MCP "Streamable HTTP", plain JSON answers). A tool call is a request:
 * it joins the mailbox like a call from another board, the agent runs now, and its own rules and
 * verifier decide; the reply is the result. Off with a config.h from before MCP_KEY existed. */
#ifdef MCP_KEY
#define TLG_MCP_ON 1
#ifndef MCP_WAIT_MS
#define MCP_WAIT_MS 10000
#endif
#if defined(ESP8266)
#define MCP_OUT 3072
#else
#define MCP_OUT 8192
#endif
static tlg_mcp_t mcp;
static __attribute__((unused)) bool mcp_inline;               /* ESP8266: a run started by MCP; pump() leaves the web server alone */

static bool mcp_run_now(void *ctx, uint32_t wait_ms)
{
    (void)ctx;
    if (!agent_ok || pending_run) return false;           /* waiting for a human: busy */
#if defined(ESP8266)
    (void)wait_ms;
    if (agent_running) return false;
    mcp_inline = true;                                    /* approvals: BOOT button or Serial only */
    run_requested = true;
    agent_poll();
    mcp_inline = false;
    return true;
#else
    uint32_t want = agent_done + (agent_running ? 2 : 1); /* a run already going missed the request */
    run_requested = true;
    uint32_t t0 = millis();
    while ((int32_t)(agent_done - want) < 0 && millis() - t0 < wait_ms) delay(10);
    return true;                                          /* no answer yet: tlg_mcp says so */
#endif
}

static int mcp_status(void *ctx, char *buf, size_t size)
{
    (void)ctx;
    return @p@_status_json(&state, buf, size);
}

static void mcp_begin(void)
{
    mcp.board = "@p@";
    mcp.about = "@ABOUT@";
    mcp.contracts = @p@_mcp_list(&mcp.n_contracts);
#if TLG_USE_NET
    mcp.net = @p@_net();
#endif
    mcp.key = MCP_KEY;
    mcp.wait_ms = MCP_WAIT_MS;
    mcp.run_now = mcp_run_now;
    mcp.status = mcp_status;
}

static void handle_mcp()
{
    static char out[MCP_OUT];
    int http = 200;
    const String &body = server.arg("plain");
    String auth = server.header("Authorization");
    int n = tlg_mcp_handle(&mcp, body.c_str(), body.length(), auth.length() ? auth.c_str() : NULL,
                           out, sizeof out, &http);
    no_cache();
    if (n <= 0) server.send(http);
    else server.send(http, "application/json", out);
}
#else
#define TLG_MCP_ON 0
static __attribute__((unused)) bool mcp_inline;
static void mcp_begin(void) {}
static void handle_mcp() { server.send(404, "text/plain", "MCP is off: add MCP_KEY to config.h"); }
#endif

static void start_network()
{
    set_hostname(HOSTNAME);
    bool joined = false;
    if (strlen(WIFI_SSID) > 0) {
        WiFi.mode(WIFI_STA);
        WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
        Serial.printf("joining Wi-Fi \"%s\"", WIFI_SSID);
        for (int i = 0; i < 30 && WiFi.status() != WL_CONNECTED; i++) { delay(500); Serial.print("."); }
        Serial.println();
        joined = WiFi.status() == WL_CONNECTED;
    }
    IPAddress ip;
    if (joined) {
        ip = WiFi.localIP();
        time_sync();
    } else {
        WiFi.mode(WIFI_AP);
        WiFi.softAP(HOSTNAME, AP_PASSWORD);
        ip = WiFi.softAPIP();
        Serial.printf("no Wi-Fi: started network \"%s\" (password \"%s\")\n", HOSTNAME, AP_PASSWORD);
    }
    if (MDNS.begin(HOSTNAME)) MDNS.addService("http", "tcp", 80);

    server.on("/", HTTP_GET, handle_root);
    server.on("/tlg/info", HTTP_GET, handle_info);
    server.on("/tlg/events", HTTP_GET, handle_events);
    server.on("/tlg/pending", HTTP_GET, handle_pending);
    server.on("/tlg/answer", HTTP_POST, handle_answer);
    server.on("/snapshot.jpg", HTTP_GET, handle_snapshot);
    server.on("/tlg/log", HTTP_GET, handle_log_list);
    server.on("/tlg/log.csv", HTTP_GET, handle_log_csv);
    server.on("/tlg/log/clear", HTTP_POST, handle_log_clear);
    server.on("/mcp", HTTP_POST, handle_mcp);
    server.on("/mcp", HTTP_GET, []() { server.sendHeader("Allow", "POST"); server.send(405); });
    server.onNotFound([]() { server.send(404, "text/plain", "not found"); });
#if defined(ESP8266)
    server.collectHeaders("Authorization");
#else
    static const char *headers[] = { "Authorization" };
    server.collectHeaders(headers, 1);
#endif
    mcp_begin();
    server.begin();
    Serial.printf("\nopen  http://%s/   or   http://%s.local/\n", ip.toString().c_str(), HOSTNAME);
#if TLG_MCP_ON
    Serial.printf("MCP:  http://%s/mcp   %d tools, key in config.h (MCP_KEY)\n\n", ip.toString().c_str(),
                  mcp.n_contracts + 1);
#else
    Serial.println("MCP:  off (config.h has no MCP_KEY)\n");
#endif
}

/* ---------------- setup / loop ---------------- */
void setup()
{
    Serial.begin(115200);
    delay(1500);
    Serial.println("\ntiny-langgraph: @NAME@ on " TLG_BOARD);
    pinMode(BOOT_PIN, INPUT_PULLUP);
    boot_id = board_random();

    size_t bytes = (size_t)HUB_SLOTS * sizeof(tlg_hub_slot_t);
    void *mem = big_alloc(bytes);
    if (!mem) { bytes = 8 * sizeof(tlg_hub_slot_t); mem = malloc(bytes); }
    hub_lock = lock_new();
    Serial.printf("event memory: %lu events\n", (unsigned long)tlg_hub_init(&hub, mem, mem ? bytes : 0));
    tracer.write = trace_write;
    tracer.clock = clock_ms;

    @p@_state_init(&state);
    @p@_drivers_init();
    log_begin();
#if TLG_PLAN_STATES > 0                   /* more than 8 goals: the planner's workspace (PSRAM if any) */
    {
        size_t bytes = TLG_PLAN_WORKSPACE_BYTES(TLG_PLAN_STATES);
        void *ws = big_alloc(bytes);
        tlg_plan_workspace(ws, ws ? bytes : 0);
        Serial.printf("planner: room for %lu states (%lu KB)%s\n", (unsigned long)tlg_plan_capacity(),
                      (unsigned long)(bytes / 1024), ws ? "" : " NOT allocated: plans will be greedy");
    }
#endif

#if TLG_HAS_MODEL
    uint32_t heap = ESP.getFreeHeap();
    bool model_ok = tlg_lm_init(&lm, @P@_MODEL, @P@_MODEL_LEN) && lm.cfg.vocab == @P@_N_TOKENS;
    Serial.printf("model: %s (%lu bytes of weights in flash, %lu bytes of RAM)\n",
                  model_ok ? "loaded" : "NOT loaded, planner only", (unsigned long)@P@_MODEL_LEN,
                  (unsigned long)(heap - ESP.getFreeHeap()));
    state.agent.lm = model_ok ? &lm : NULL;
#elif TLG_USES_MODEL
    Serial.println("model: none (planner decides); run the build with PyTorch installed to train one");
    state.agent.lm = NULL;
#else
    Serial.println("decisions: rules + planner (no model)");
#endif
    state.agent.clock_us = clock_us;
    state.agent.tracer = &tracer;
    state.agent.log = human_log;

    start_network();
    net_begin();                          /* ESP-NOW, if the agent talks to other boards */
    Serial.printf("free heap: %lu bytes%s\n", (unsigned long)ESP.getFreeHeap(), big_memory() ? " (+ PSRAM)" : "");
#if defined(ESP32)
    xTaskCreatePinnedToCore(agent_task, "agent", 16384, NULL, 1, NULL, 1);
#else
    agent_start();                        /* runs from loop() */
#endif
}

/* Serial Monitor: r = run now, y/n = answer a pending question */
static void handle_serial(void)
{
    while (Serial.available()) {
        char c = (char)tolower(Serial.read());           /* r, R, y, Y, n, N */
        if (c == 'y' || c == 'n') {
            if (!give_answer(0, c == 'y', "serial monitor")) Serial.println("nothing is waiting for an answer");
        } else if (c == 'r') {
            run_requested = true;
        }
    }
}

#if defined(ESP8266)
static void pump(void)
{
    if (!mcp_inline) server.handleClient();      /* not from inside the /mcp handler */
    net_service();
    MDNS.update();
    handle_serial();
}
#endif

void loop()
{
    server.handleClient();
    net_service();
    handle_serial();
#if defined(ESP8266)
    MDNS.update();
    agent_poll();                         /* no tasks on the ESP8266: the agent runs here */
#endif
    delay(2);
}
